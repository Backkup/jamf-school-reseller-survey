{
  "name": "apnsmaster",
  "version": "1.2.1-beta",
  "buildSnapshot": 21,
  "description": "Audit des certificats Jamf School par revendeur",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "keywords": [],
  "author": "Hegeoma",
  "license": "ISC",
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hegeoma.jamfschoolresellersurvey",
    "productName": "Jamf School Reseller Survey",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": "dir",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Accès Bluetooth requis pour les clés de sécurité / clés d'accès (FIDO).",
        "NSBluetoothPeripheralUsageDescription": "Accès Bluetooth requis pour les clés de sécurité / clés d'accès (FIDO)."
      }
    },
    "files": [
      "main.js",
      "scraper.js",
      "report.js",
      "slack.js",
      "preload.js",
      "i18n.js",
      "renderer/**/*",
      "data/**/*",
      "node_modules/**/*"
    ]
  }
}
